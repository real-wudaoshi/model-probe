{
  "name": "model-probe",
  "description": "Probe OpenAI-compatible gateways (LiteLLM, One API, New API, Ollama, ...) for models and metadata",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "model-probe": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "rules.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test \"test/**/*.test.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/models": "^0.0.132"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-wudaoshi/model-probe.git"
  },
  "version": "0.8.1",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}

{
	// Type-check everything (sources + tests) without emitting. The published
	// JavaScript is produced by tsconfig.build.json.
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["index.ts", "cli.ts", "src", "test"]
}
